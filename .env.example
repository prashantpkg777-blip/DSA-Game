# ==============================================================================
# DSA CHAOS — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE BACKEND (PostgreSQL + Auth + Row Level Security + Stored Procedures)
# ------------------------------------------------------------------------------
# Get these from your Supabase Dashboard -> Project Settings -> API.
# Note: If these variables are omitted or contain placeholders, DSA Chaos
# will automatically and safely run in Guest Mode using localStorage persistence.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ------------------------------------------------------------------------------
# SECURITY NOTICE
# ------------------------------------------------------------------------------
# NEVER put your SUPABASE_SERVICE_ROLE_KEY in frontend .env or VITE_ variables!
# The frontend only uses the public anon key. All sensitive database operations
# (XP increments, achievements, streak calculations) are guarded strictly
# by PostgreSQL Row Level Security (RLS) and SECURITY DEFINER stored procedures.

# ------------------------------------------------------------------------------
# CODE EXECUTION BACKEND (OPTIONAL)
# ------------------------------------------------------------------------------
# JavaScript is executed directly in-browser using a hardened Web Worker sandbox
# with network isolation and a 2.5s watchdog timeout.
# For remote multi-language execution (Python, Java, C++), configure an isolated
# backend sandbox API (e.g. Judge0 or Piston instance):
VITE_CODE_EXECUTION_API_URL=
